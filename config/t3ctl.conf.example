# t3ctl configuration (optional).
#
# Copy to ~/.config/t3ctl/config (or point T3CTL_CONFIG at another file).
# The file is sourced by bash, so it must be owned by you (or root) and must
# not be group/world-writable. Every value below is the built-in default.

# Unix account that runs the coding agents and owns the user service.
#AGENT_USER="agent"

# systemd *user* unit (in AGENT_USER's manager) to manage.
#T3_SERVICE="t3code.service"

# TCP port the service is expected to listen on. Empty disables the check.
#T3_PORT="3773"

# Application log file written by the service (StandardOutput=append:...).
# Defaults to <agent home>/.t3/userdata/logs/boot-service.log
#T3_LOG_FILE=""

# Directory containing agent worktrees.
# Defaults to <agent home>/.t3/worktrees
#WORKTREE_ROOT=""

# How deep below WORKTREE_ROOT to look for worktrees (root/<project>/<name> = 2).
#WORKTREE_SCAN_DEPTH=4

# Directory *names* that `t3ctl worktree <id> clean` may delete. Only
# directories that git ignores and that contain no tracked files are removed.
#SAFE_CLEAN_DIRS=(node_modules .next .turbo dist build coverage)

# Agent home sub-directories reported by `t3ctl disk`.
#AGENT_STORAGE_DIRS=(.t3/worktrees .cache .bun .local .codex .cursor .npm)

# Disk usage thresholds (percent).
#DISK_WARN_PCT=85
#DISK_CRIT_PCT=95

# Warn when worktrees take at least this share (percent) of used disk space.
#WORKTREE_WARN_PCT=50

# Seconds to wait for the user bus / service / port after recovery actions.
#BUS_WAIT_SECONDS=10
#START_TIMEOUT_SECONDS=30

# Extended regex matched against process names (comm) inside the service's
# cgroup. Matching processes are reported before stop/restart/reset/update, which
# would terminate them, and the command asks for confirmation.
#AGENT_PROCESS_PATTERN='^(claude|codex|cursor|cursor-agent|gemini|opencode|aider|amp)$'

# Command to update the T3 installation used by the service. No default:
# choose the command that matches your installation, using absolute paths
# when the agent's package manager is not on the operator's PATH.
# Executed as AGENT_USER from its home directory, without a login shell.
# Arguments are a bash array, never evaluated as shell code.
# Use an executable script that performs your package update or pull/build steps and returns nonzero on any failure:
#T3_UPDATE_COMMAND=(/home/agent/bin/update-t3)

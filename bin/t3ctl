#!/usr/bin/env bash
# t3ctl - operations CLI for a coding-agent host.
set -euo pipefail

T3CTL_HOME=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)

# shellcheck source=lib/common.sh
source "$T3CTL_HOME/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$T3CTL_HOME/lib/ui.sh"
# shellcheck source=lib/service.sh
source "$T3CTL_HOME/lib/service.sh"
# shellcheck source=lib/worktrees.sh
source "$T3CTL_HOME/lib/worktrees.sh"
# shellcheck source=lib/disk.sh
source "$T3CTL_HOME/lib/disk.sh"

usage() {
  cat <<'EOF'
Usage: t3ctl [--yes] <command> [args]

Service (agent's systemd user service):
  service status            show service, user manager, bus and port state
  service start|stop        start / stop the service
  service restart           restart the service
  service update            run configured T3 updater, restart and verify
  service reset             recover: ensure bus, stop, reset-failed, start, verify
  service logs [opts]       show logs (-n N, -f, --journal, --file)

  status | start | stop | restart | reset | update | logs   aliases for the above

Worktrees:   one grammar for listing and for every action
  worktrees [list] [selection] [--sort size|age|project|commit] [-r] [--no-size]
  worktrees info|clean|remove [selection] [--dry-run] [--force]
  worktree <id>[,id...] info|clean|remove [--dry-run] [--force]   (same, by ID)

  selection = IDs (unique prefixes ok) and/or filters, combined with AND:
      --all                        every worktree (actions need --all, IDs or a filter)
      --project NAME[,NAME]        project directory, globs ok (--project 'olta*')
      --name GLOB                  worktree directory name
      --branch GLOB                checked-out branch
      --older-than DUR             last activity at least this old (12h, 7d, 2w, 3mo)
      --newer-than DUR             last activity more recent than this
      --before YYYY-MM-DD          last activity before local midnight
      --larger-than SIZE           e.g. 500M, 2G
      --pushed | --unpushed        HEAD on a remote branch, or on none
      --dirty | --clean            has / has no uncommitted changes
      --safe | --status LIST       removal verdict: safe, risk (needs --force), blocked
  info    inspect; clean: delete generated artifacts; remove: git worktree remove
  --dry-run   show the plan and change nothing
  --force     (remove) also remove worktrees that fail the safety checks, e.g. ahead
              of origin or with uncommitted changes. Discards uncommitted work;
              branches are kept. Locked, broken and main checkouts stay protected.

Host:
  disk                      filesystem and agent storage usage
  doctor                    diagnose runtime and storage health

Options:
  -y, --yes                 do not ask for confirmation (also accepted after the command)
  -h, --help                show this help
  -V, --version             show version

Configuration: ~/.config/t3ctl/config (see config/t3ctl.conf.example).
EOF
}

main() {
  T3CTL_ASSUME_YES=${T3CTL_ASSUME_YES:-0}
  while (($#)); do
    case $1 in
      -y | --yes) T3CTL_ASSUME_YES=1 ;;
      -h | --help | help)
        usage
        return 0
        ;;
      -V | --version)
        printf 't3ctl %s\n' "$T3CTL_VERSION"
        return 0
        ;;
      -*) die "unknown option: $1 (see t3ctl --help)" ;;
      *) break ;;
    esac
    shift
  done
  (($#)) || {
    usage >&2
    return 2
  }

  load_config

  local cmd=$1
  shift
  case $cmd in
    service)
      (($#)) || die "usage: t3ctl service status|start|stop|restart|reset|update|logs"
      local sub=$1
      shift
      service_dispatch "$sub" "$@"
      ;;
    status | start | stop | restart | reset | update | logs) service_dispatch "$cmd" "$@" ;;
    worktrees) cmd_worktrees "$@" ;;
    worktree)
      (($# >= 2)) || die "usage: t3ctl worktree <id> [id...] info|clean|remove [--dry-run] [--force]"
      cmd_worktree "$@"
      ;;
    disk) cmd_disk "$@" ;;
    doctor) cmd_doctor "$@" ;;
    *) die "unknown command: $cmd (see t3ctl --help)" ;;
  esac
}

main "$@"
